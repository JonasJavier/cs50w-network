# Copy to .env and adjust. Every variable is optional in development:
# without a .env the API runs with SQLite + a local-memory cache.

# --- Core ------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to POST to the admin (https://app.example.com)
# CSRF_TRUSTED_ORIGINS=

# --- Database (PostgreSQL in staging/production) ---------------------------
# DATABASE_URL=postgres://network:network@localhost:5432/network
# DB_CONN_MAX_AGE=600
# DB_SSL_REQUIRE=0

# --- Cache / Redis (optional; falls back to in-process memory) -------------
# REDIS_URL=redis://localhost:6379/0

# --- CORS: origins of the React app ----------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.up\.railway\.app$

# --- JWT lifetimes ----------------------------------------------------------
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=7

# --- Throttling -------------------------------------------------------------
# THROTTLE_ANON=60/min
# THROTTLE_USER=600/min
# THROTTLE_AUTH=10/min

# --- Uploads ----------------------------------------------------------------
# MAX_UPLOAD_SIZE=5242880          # bytes (5 MB)
# IMAGE_QUALITY=85                  # WebP quality for processed uploads
# MEDIA_ROOT=/app/media             # mount a persistent volume here in production
# SERVE_MEDIA=1                     # serve MEDIA_ROOT through Django (default when no S3)

# --- Optional S3-compatible storage (AWS S3, Railway Bucket, R2, MinIO) ----
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=

# --- Production only ----------------------------------------------------------
# DJANGO_SECURE_SSL_REDIRECT=1      # set 0 when TLS is terminated by a proxy without X-Forwarded-Proto
# WEB_CONCURRENCY=2                 # gunicorn workers
# MIGRATE_ON_START=1                # set 0 when migrations run in a pre-deploy hook
# SEED_ON_START=0                   # 1 → load the demo data set on boot (idempotent; demo deployments)
# LOG_LEVEL=INFO
# SENTRY_DSN=
